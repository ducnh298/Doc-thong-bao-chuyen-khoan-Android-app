<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/background_dialog" />
                    <stroke android:width="2dp" android:color="@color/stroke_color" />
                    <corners android:radius="3dp" />
                    <padding android:bottom="4dp" android:left="12dp" android:right="32dp" android:top="4dp" />
                </shape>
            </item>
            <item android:gravity="center_vertical|right" android:drawable="@drawable/ic_arrow_down" android:right="8dp" />
        </layer-list>
    </item>
</selector>
